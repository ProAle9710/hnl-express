{
  "expo": {
    "name": "HNL-EXPRESS",
    "slug": "hnl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "HN Express usa la cámara para fotografiar el comprobante.",
        "NSPhotoLibraryUsageDescription": "HN Express lee una foto del comprobante desde la galería."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "HN Express lee una foto del comprobante desde la galería.",
          "cameraPermission": "HN Express usa la cámara para fotografiar el comprobante."
        }
      ],
      "expo-sharing"
    ]
  }
}
